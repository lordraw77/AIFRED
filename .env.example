# AIFRED bootstrap environment.
# Only what is needed before the database can be read lives here; every other setting
# (LLM providers, Telegram, tools, MCP servers, ...) is configured from the web dashboard.

# Username of the admin account.
AIFRED_ADMIN_USER=admin

# Initial password (minimum 12 characters). Used only when no admin exists yet,
# then stored hashed. Remove it from this file after the first start.
AIFRED_ADMIN_PASSWORD=

# Where the master key for stored secrets (provider API keys, Telegram token) lives:
#   file     a key in the data directory (development, single machine). Default outside Docker.
#   openbao  a Transit key in an OpenBao/Vault server; no key is kept on the volume. Recommended.
AIFRED_SECRETS_BACKEND=file   # ignored by docker compose, which always uses openbao

# --- only for AIFRED_SECRETS_BACKEND=openbao (also needed once to migrate from "file") ---
# AIFRED_OPENBAO_ADDR=http://openbao:8200
# AppRole (recommended): the role may only "update" transit/encrypt/aifred and transit/decrypt/aifred.
# AIFRED_OPENBAO_ROLE_ID=
# AIFRED_OPENBAO_SECRET_ID=
# ...or a static token instead:
# AIFRED_OPENBAO_TOKEN=
# Use these variables, not *_FILE files, if the terminal toolset is enabled: files are readable by commands it runs.
# AIFRED_OPENBAO_SECRET_ID_FILE=/run/secrets/openbao_secret_id
# AIFRED_OPENBAO_TOKEN_FILE=/run/secrets/openbao_token
# AIFRED_OPENBAO_MOUNT=transit
# AIFRED_OPENBAO_KEY=aifred
# AIFRED_OPENBAO_CACERT=/data/certs/openbao-ca.pem
# AIFRED_OPENBAO_VERIFY_TLS=true

# --- Docker deployment (docker-compose.yml, scripts/setup.sh) ---
# Only the AIFRED_* variables above reach the container; the rest of this file stays on the host.
# Interface and port published on the host. Keep 127.0.0.1 unless something in front of it handles TLS.
# AIFRED_BIND=127.0.0.1
# AIFRED_PORT=8700
# Memory limit of the AIFRED container. The knowledge base caches vectors in memory (RAG_CACHE_MB on the Config
# page, 512 by default) and the parsers need room too: raise this together with those settings.
# AIFRED_MEM_LIMIT=1g
# Image tags. Bump OPENBAO_VERSION only after running the real-server tests (docs/adr.md).
# AIFRED_VERSION=0.1.0
# OPENBAO_VERSION=2.7.1
# SEARXNG_VERSION=2026.10.24-ef0ec03da
# Written by scripts/setup.sh (do not edit): secret of the optional SearXNG (docker compose --profile search up -d)
# and a marker that the admin account exists, after which AIFRED_ADMIN_PASSWORD is cleared above.
# SEARXNG_SECRET=
# AIFRED_SETUP_ADMIN_CREATED=
